(version 1)
(allow default)
(deny network*)
(deny file-read*)
(import "dyld-support.sb")
(allow file-read*
    (subpath "/System/Library")
    (subpath "/usr")
    (subpath "/bin")
    (subpath "/sbin")
    (subpath "/Library")
    (subpath "/private/etc")
    (subpath "/etc")
    (subpath "/private/var/db")
    (subpath "/var/db/timezone")
    (subpath "/dev")
    (subpath (param "RESOURCES"))
    (subpath (param "CODEX_HOME"))
    (subpath (param "COST_CACHE"))
    (subpath (param "CLI_CACHE"))
    (subpath (param "RUNTIME_CACHE"))
    (subpath (param "TEMPORARY"))
    (subpath (param "PREFERENCES")))
(allow file-read-metadata
    (path-ancestors (param "CODEX_HOME") (param "RESOURCES")
        (param "COST_CACHE") (param "CLI_CACHE") (param "RUNTIME_CACHE")
        (param "TEMPORARY") (param "PREFERENCES"))
    (literal "/")
    (literal "/Users")
    (literal "/private")
    (literal "/private/var")
    (literal "/var")
    (literal (param "HOME")))
